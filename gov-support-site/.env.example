# 기업마당 지원사업정보 API 인증키 (https://www.bizinfo.go.kr)
BIZINFO_API_KEY=
# /api/cron/collect 호출 보호용 임의 문자열
CRON_SECRET=
# 관리자 페이지(/admin) 비밀번호. 비어 있으면 관리자 기능이 비활성화됩니다.
ADMIN_PASSWORD=
# 메일 발송 (https://resend.com): API 키와 인증된 발신 주소
RESEND_API_KEY=
EMAIL_FROM=지원톡 <noreply@your-domain.com>
# 수신 거부 링크의 서명 키(없으면 CRON_SECRET 사용) / 메일 링크의 사이트 주소
UNSUBSCRIBE_SECRET=
SITE_URL=https://your-domain.com
